# ===========================================================================
#  LOCAL DEVELOPMENT SETTINGS
#  This file is SECRET. It is in .gitignore and must never be committed.
# ===========================================================================

# ---- Django core ----
SECRET_KEY=generate-your-own-see-README
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Karachi

# ---- Which frontend URLs may call this API ----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Database (Neon) -------------------------------------------------------
# PASTE YOUR NEON CONNECTION STRING ON THE LINE BELOW.
# It looks like:
#   postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb
# Leave it empty and the project will use a local SQLite file instead.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb

# ---- Weather (Phase 3) -----------------------------------------------------
OPENWEATHER_API_KEY=

# ---- Image hosting (Phase 2) ----------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Virtual Try-On (Phase 5) --------------------------------------------
FAL_KEY=
