        name: has_image
        schema:
          type: boolean
      - in: query
        name: is_favorite
        schema:
          type: boolean
      - in: query
        name: location
        schema:
          type: string
        description: Storage location (includes everything nested inside it)
      - in: query
        name: no_location
        schema:
          type: boolean
        description: Items whose storage place has not been recorded
      - in: query
        name: occasion
        schema:
          type: string
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: season
        schema:
          type: string
        description: Items suitable for this season (items with no season set always
          match)
      - in: query
        name: slot
        schema:
          type: string
          enum:
          - ACCESSORY
          - BOTTOM
          - FOOTWEAR
          - FULL_BODY
          - HEADWEAR
          - OTHER
          - OUTERWEAR
          - TOP
        description: |-
          Outfit slot (TOP, BOTTOM, FOOTWEAR...)

          * `TOP` - Top
          * `BOTTOM` - Bottom
          * `FULL_BODY` - Full body
          * `OUTERWEAR` - Outerwear
          * `FOOTWEAR` - Footwear
          * `ACCESSORY` - Accessory
          * `HEADWEAR` - Headwear
          * `OTHER` - Other
      - in: query
        name: status
        schema:
          type: string
          enum:
          - ARCHIVED
          - FOR_SALE
          - IN_LAUNDRY
          - IN_WARDROBE
          - LENT_OUT
          - SOLD
        description: |-
          * `IN_WARDROBE` - In wardrobe
          * `IN_LAUNDRY` - In the wash
          * `LENT_OUT` - Lent to a friend
          * `FOR_SALE` - Listed for sale
          * `SOLD` - Sold
          * `ARCHIVED` - Archived
      - in: query
        name: unworn_days
        schema:
          type: number
        description: Not worn for at least this many days (never-worn items count)
      - in: query
        name: wearable
        schema:
          type: boolean
        description: Only items available to wear right now
      tags:
      - Wardrobe
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedGarmentItemListList'
          description: ''
    post:
      operationId: api_wardrobe_items_create
      tags:
      - Wardrobe
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GarmentItemRequest'
          application/x-www-form-urlencoded:
