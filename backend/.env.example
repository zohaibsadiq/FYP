# Template for backend/.env. Copy it to .env and fill in real values.
# This template is tracked in git; .env is not.

# Django core
SECRET_KEY=dev-only-replace-before-deploying
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Karachi

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
# Postgres DSN, e.g. postgresql://user:password@host/dbname
# Empty falls back to a local SQLite file.
DATABASE_URL=

# Weather
OPENWEATHER_API_KEY=

# Image hosting
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Virtual try-on
FAL_KEY=
